--Average engagement rate by post type
--this query analyzes content performance by post type. It calculates average engagement, average shareability and number of posts for each type. Then it ranks the post types by engagement rate from the highest to lowest.
SELECT 
post_type,
COUNT(*) AS num_posts,
ROUND(AVG(engagement_rate)*100,2) AS avg_engagement_rate,
 FROM `practice-475920.pet_creators.pet_creators_data`
 WHERE
 is_viral = "normal"
GROUP BY 
post_type
ORDER BY
avg_engagement_rate DESC
